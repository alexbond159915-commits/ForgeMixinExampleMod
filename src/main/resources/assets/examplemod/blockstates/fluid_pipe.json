{
  "multipart": [
    {
      "apply": {
        "model": "examplemod:fluid_pipe_core"
      }
    },
    {
      "when": {
        "posx": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_pos_x"
      }
    },
    {
      "when": {
        "negx": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_neg_x"
      }
    },
    {
      "when": {
        "posy": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_pos_y"
      }
    },
    {
      "when": {
        "negy": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_neg_y"
      }
    },
    {
      "when": {
        "posz": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_pos_z"
      }
    },
    {
      "when": {
        "negz": "true"
      },
      "apply": {
        "model": "examplemod:fluid_pipe_arm_neg_z"
      }
    }
  ]
}